// String functions
fn print(value):
    __rt_print_str(value)

fn print_int(value):
    __rt_print_int(value)

fn print_float(value):
    __rt_print_float(value)

fn len(value):
    return __rt_strlen(value)

fn is_empty(value):
    return __rt_strlen(value) == 0

fn contains(s, sub):
    return __rt_contains(s, sub)

fn starts_with(s, prefix):
    return __rt_starts_with(s, prefix)

fn ends_with(s, suffix):
    return __rt_ends_with(s, suffix)

fn substr(s, start, length):
    return __rt_wrap_string(__rt_substr(s, start, length))

fn trim(s):
    return __rt_wrap_string(__rt_trim(s))

fn to_uppercase(s):
    return __rt_wrap_string(__rt_to_uppercase(s))

fn to_lowercase(s):
    return __rt_wrap_string(__rt_to_lowercase(s))

fn to_string(v):
    return v

fn str_repeat(s, count):
    return __rt_wrap_string(__rt_str_repeat(s, count))

fn to_int(s):
    return __rt_to_int(s)

fn to_float(s):
    return __rt_to_float(s)

fn to_hex(n):
    return __rt_wrap_string(__rt_to_hex(n))

fn read_line():
    return __rt_wrap_string(__rt_read_line())

fn read_int():
    return to_int(read_line())

fn read_float():
    return to_float(read_line())
