// Result type
enum Result:
    Ok(i32)
    Err(i32)

fn result_is_ok(res):
    match res {
        Ok(_) : return 1,
        Err(_) : return 0,
    }

fn result_unwrap(res):
    match res {
        Ok(val) : return val,
        Err(_) : return 0,
    }

fn result_unwrap_or(res, default):
    match res {
        Ok(val) : return val,
        Err(_) : return default,
    }
